{"title":"SemantiCache","uid":"semanticache","schemaVersion":39,"refresh":"5s","time":{"from":"now-15m","to":"now"},
 "panels":[
  {"id":1,"type":"stat","title":"Hit rate","gridPos":{"x":0,"y":0,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prom"},
   "fieldConfig":{"defaults":{"unit":"percentunit"}},
   "targets":[{"expr":"sum(semanticache_requests_total{status=~\"HIT.*|VERIFIED\"}) / sum(semanticache_requests_total{status=~\"HIT.*|VERIFIED|MISS\"})"}]},
  {"id":2,"type":"stat","title":"USD saved","gridPos":{"x":6,"y":0,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prom"},
   "fieldConfig":{"defaults":{"unit":"currencyUSD"}},"targets":[{"expr":"semanticache_cost_saved_usd_total"}]},
  {"id":3,"type":"gauge","title":"Similarity threshold (agent-tuned)","gridPos":{"x":12,"y":0,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prom"},
   "fieldConfig":{"defaults":{"min":0.8,"max":0.97}},"targets":[{"expr":"semanticache_threshold"}]},
  {"id":4,"type":"timeseries","title":"Requests by status","gridPos":{"x":0,"y":5,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prom"},
   "targets":[{"expr":"sum by (status) (rate(semanticache_requests_total[1m]))","legendFormat":"{{status}}"}]},
  {"id":5,"type":"timeseries","title":"p95 latency by status","gridPos":{"x":12,"y":5,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prom"},
   "fieldConfig":{"defaults":{"unit":"s"}},
   "targets":[{"expr":"histogram_quantile(0.95, sum by (le,status) (rate(semanticache_latency_seconds_bucket[1m])))","legendFormat":"{{status}}"}]}
 ]}
